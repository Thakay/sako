<svg xmlns="http://www.w3.org/2000/svg" width="560" height="640" viewBox="0 0 560 640" role="img" aria-labelledby="title desc">
  <title id="title">One request, two coordinated sessions</title>
  <desc id="desc">A request for a greeting and usage guide is split between a code session and a docs session. Both tasks pass the project checks and leave receipts. A fresh session sees the next task.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 1 1 L 8 5 L 1 9" fill="none" stroke="#74b8ad" stroke-width="1.5"/></marker>
  </defs>
  <style>
    text { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; fill: #f4f7f6; }
    .label { font-size: 14px; font-weight: 650; letter-spacing: 1.5px; fill: #9eb7bf; }
    .title { font-size: 24px; font-weight: 650; }
    .body { font-size: 21px; }
    .small { font-size: 18px; fill: #c1d2d7; }
    .mono { font-family: ui-monospace, "Cascadia Code", "DejaVu Sans Mono", monospace; font-size: 18px; }
    .mint { fill: #91e4cd; }
    .flow { fill: none; stroke: #74b8ad; stroke-width: 1.5; marker-end: url(#arrow); }
  </style>
  <rect width="560" height="640" rx="20" fill="#12242e"/>
  <text x="32" y="42" class="label">01 / YOUR REQUEST</text>
  <rect x="32" y="62" width="496" height="92" rx="12" fill="#203841" stroke="#37525b"/>
  <text x="52" y="100" class="title">Add a greeting by name</text>
  <text x="52" y="132" class="title">and show how to use it.</text>
  <path d="M 280 154 V 177 H 150 V 194" class="flow"/>
  <path d="M 280 177 H 410 V 194" class="flow"/>
  <text x="32" y="226" class="label">02 / TWO SESSIONS, CLEAR OWNERSHIP</text>
  <rect x="32" y="246" width="238" height="132" rx="12" fill="#203841" stroke="#37525b"/>
  <rect x="290" y="246" width="238" height="132" rx="12" fill="#203841" stroke="#37525b"/>
  <text x="52" y="282" class="title">Code session</text>
  <text x="310" y="282" class="title">Docs session</text>
  <text x="52" y="316" class="mono">greeting.py</text>
  <text x="310" y="316" class="mono">USAGE.md</text>
  <text x="52" y="353" class="small mint">${code_claim}</text>
  <text x="310" y="353" class="small mint">${docs_claim}</text>
  <path d="M 150 378 V 401 H 280 V 420" class="flow"/>
  <path d="M 410 378 V 401 H 280" fill="none" stroke="#74b8ad" stroke-width="1.5"/>
  <text x="32" y="452" class="label">03 / A RESULT YOU CAN REVIEW</text>
  <text x="32" y="490" class="body mint">${check}</text>
  <text x="32" y="522" class="small">${receipts} task receipts. Changes committed.</text>
  <path d="M 32 548 H 528" stroke="#37525b"/>
  <text x="32" y="581" class="label">NEXT SESSION</text>
  <text x="32" y="615" class="body">${next_task}</text>
</svg>
